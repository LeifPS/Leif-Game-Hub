# Bilder der Spiele (Icons, Titelbilder, Wallpaper) werden bei jedem Aufruf beim Server nachgefragt (ETag) und nur neu geladen, wenn sie sich geändert haben.
# Nur die nummerierten Screenshots in screens/shots/ dürfen einen Tag lang ohne Nachfrage aus dem Zwischenspeicher kommen.
/screens/shots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Seite und Programmdateien werden bei jedem Aufruf beim Server nachgefragt (ETag), damit nie eine alte index.html mit neuem style.css gemischt wird.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/konto.js
  Cache-Control: no-cache
/spielmenue.js
  Cache-Control: no-cache
/dev/
  Cache-Control: no-cache
/dev/index.html
  Cache-Control: no-cache
/dev/dev.js
  Cache-Control: no-cache
/dev/dev.css
  Cache-Control: no-cache
