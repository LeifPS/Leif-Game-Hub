{
  "name": "leif-game-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lgh", "database_id": "9582193f-3ae1-48ad-b591-2e9ee2607f4d" }
  ]
}
